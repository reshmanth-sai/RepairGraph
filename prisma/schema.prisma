generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  USER
  REPAIRER
  ADMIN
}

enum DeviceCategory {
  SMARTPHONE
  LAPTOP
  TABLET
  HEADPHONES
  MONITOR
}

enum DeviceCondition {
  EXCELLENT
  GOOD
  FAIR
  DEGRADED
  CRITICAL
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  REQUESTED
  ACCEPTED
  DIAGNOSING
  WAITING_FOR_PART
  REPAIRING
  TESTING
  COMPLETED
  CANCELLED
}

enum RecommendedAction {
  REPAIR
  DIY
  REPLACE
  RESELL
  RECYCLE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  ACCEPTED
  DIAGNOSING
  WAITING_FOR_PART
  REPAIRING
  TESTING
  COMPLETED
  CANCELLED
}

// --------------------------------------------------------
// MODELS
// --------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices         Device[]
  repairRequests  RepairRequest[]
  repairerProfile Repairer?
  reviews         Review[]

  @@index([email])
  @@index([role])
}

model Device {
  id             String          @id @default(cuid())
  userId         String
  category       DeviceCategory
  brand          String
  model          String
  serialNumber   String
  purchaseDate   DateTime?
  purchasePrice  Float?
  warrantyExpiry DateTime?
  currentValue   Float?
  condition      DeviceCondition @default(GOOD)
  imageUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repairRequests RepairRequest[]
  repairHistory  RepairHistory[]

  @@index([userId])
  @@index([category])
  @@index([serialNumber])
}

model RepairRequest {
  id          String        @id @default(cuid())
  deviceId    String
  userId      String
  description String
  urgency     UrgencyLevel  @default(MEDIUM)
  status      RequestStatus @default(REQUESTED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  device         Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosis      Diagnosis?
  recommendation RepairRecommendation?
  quotes         Quote[]
  repairJob      RepairJob?

  @@index([deviceId])
  @@index([userId])
  @@index([status])
}

model Diagnosis {
  id              String   @id @default(cuid())
  repairRequestId String   @unique
  issueCategory   String
  possibleIssue   String
  confidence      Float    // Value between 0 and 100
  evidence        String[]
  createdAt       DateTime @default(now())

  repairRequest   RepairRequest @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
}

model RepairRecommendation {
  id                 String            @id @default(cuid())
  repairRequestId    String            @unique
  repairabilityScore Float             // Value between 0 and 100
  economicScore      Float             // Value between 0 and 100
  recommendedAction  RecommendedAction
  estimatedCostMin   Float
  estimatedCostMax   Float
  reasoning          String
  createdAt          DateTime          @default(now())

  repairRequest      RepairRequest     @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
}

model Repairer {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String
  description        String?
  address            String
  latitude           Float?
  longitude          Float?
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float              @default(0)
  totalJobs          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations RepairerSpecialization[]
  quotes          Quote[]
  repairJobs      RepairJob[]
  repairHistory   RepairHistory[]
  reviews         Review[]

  @@index([verificationStatus])
  @@index([rating])
}

model RepairerSpecialization {
  id             String         @id @default(cuid())
  repairerId     String
  deviceCategory DeviceCategory
  brand          String
  serviceType    String

  repairer       Repairer       @relation(fields: [repairerId], references: [id], onDelete: Cascade)

  @@index([repairerId])
  @@index([deviceCategory, brand])
}

model Quote {
  id              String      @id @default(cuid())
  repairRequestId String
  repairerId      String
  estimatedCost   Float
  estimatedDays   Int
  notes           String?
  status          QuoteStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  repairRequest   RepairRequest @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  repairer        Repairer      @relation(fields: [repairerId], references: [id], onDelete: Cascade)
  repairJob       RepairJob?

  @@index([repairRequestId])
  @@index([repairerId])
  @@index([status])
}

model RepairJob {
  id              String     @id @default(cuid())
  repairRequestId String     @unique
  repairerId      String
  quoteId         String     @unique
  status          JobStatus  @default(ACCEPTED)
  agreedCost      Float
  actualCost      Float?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  repairRequest   RepairRequest  @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  repairer        Repairer       @relation(fields: [repairerId], references: [id], onDelete: Cascade)
  quote           Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  repairHistory   RepairHistory?
  review          Review?

  @@index([repairerId])
  @@index([status])
}

model RepairHistory {
  id                 String             @id @default(cuid())
  deviceId           String
  repairJobId        String             @unique
  repairType         String
  issue              String
  partsReplaced      String[]
  cost               Float
  repairerId         String
  repairDate         DateTime           @default(now())
  notes              String?
  verificationStatus VerificationStatus @default(VERIFIED)
  createdAt          DateTime           @default(now())

  device             Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  repairJob          RepairJob          @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  repairer           Repairer           @relation(fields: [repairerId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([repairerId])
}

model Review {
  id          String   @id @default(cuid())
  repairJobId String   @unique
  userId      String
  repairerId  String
  rating      Int      // 1 to 5
  comment     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repairJob   RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  repairer    Repairer  @relation(fields: [repairerId], references: [id], onDelete: Cascade)

  @@index([repairerId])
  @@index([userId])
}
