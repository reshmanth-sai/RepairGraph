# =============================================================================
# RepairGraph Environment Configuration Template
# Copy this file to .env or .env.local and populate with your environment values.
# DO NOT commit real secrets or credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Standard connection string for local development or managed PostgreSQL:
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/repairgraph?schema=public"

# Optional: Direct connection string for Prisma migrations when using connection
# pooling proxies (e.g., PgBouncer, Neon pooling, Supabase pooler):
# DIRECT_URL="postgresql://postgres:password@localhost:5432/repairgraph?schema=public"

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens. Must be >= 32 chars in production.
# Generate in terminal: openssl rand -base64 32
JWT_SECRET="replace-with-a-cryptographically-secure-random-string-at-least-32-bytes"

# JWT token expiration duration (e.g., 7d, 24h, 3600s)
JWT_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# Application Runtime
# -----------------------------------------------------------------------------
# Local development server port
PORT=3000

# Node execution environment: 'development' | 'test' | 'production'
NODE_ENV="development"

# Canonical public base URL of the application (used for CORS and absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
